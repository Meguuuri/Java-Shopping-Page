<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">

    <!-- ===== Context params (read by AppContextListener -> header/footer) ===== -->
    <!-- TODO: fill in real values. Members: "Last Name, First Name" separated by semicolons -->
    <context-param>
        <param-name>headerSubject</param-name>
        <param-value>ICS2608</param-value>
    </context-param>
    <context-param>
        <param-name>headerSection</param-name>
        <param-value>SECTION</param-value>
    </context-param>
    <context-param>
        <param-name>headerMembers</param-name>
        <param-value>Calipes, FirstName; Cortez, FirstName; Dizon, FirstName</param-value>
    </context-param>
    <context-param>
        <param-name>footerMP</param-name>
        <param-value>MP4</param-value>
    </context-param>

    <!-- ===== Listeners ===== -->
    <listener>
        <listener-class>listeners.AppContextListener</listener-class>
    </listener>
    <listener>
        <listener-class>listeners.VisitorSessionListener</listener-class>
    </listener>

    <!-- ===== Filters ===== -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filters.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/user/*</url-pattern>
    </filter-mapping>
    <filter>
        <filter-name>NoCacheFilter</filter-name>
        <filter-class>filters.NoCacheFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>NoCacheFilter</filter-name>
        <url-pattern>/user/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>NoCacheFilter</filter-name>
        <url-pattern>/login.jsp</url-pattern>
    </filter-mapping>

    <!-- ===== Servlets (init-params = ServletConfig usage) ===== -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controllers.LoginServlet</servlet-class>
        <init-param>
            <param-name>successPage</param-name>
            <param-value>/user/home.jsp</param-value>
        </init-param>
        <init-param>
            <param-name>failurePage</param-name>
            <param-value>/login.jsp</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controllers.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controllers.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductServlet</servlet-name>
        <servlet-class>controllers.ProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductServlet</servlet-name>
        <url-pattern>/ProductServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>controllers.CartServlet</servlet-class>
        <init-param>
            <param-name>maxQuantity</param-name>
            <param-value>10</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/user/CartServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CheckoutServlet</servlet-name>
        <servlet-class>controllers.CheckoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/user/CheckoutServlet</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ===== Welcome files: index.jsp for "/" (Guest), home.jsp for "/user/" (User) ===== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>home.jsp</welcome-file>
    </welcome-file-list>

    <!-- ===== Custom error pages ===== -->
    <error-page>
        <error-code>400</error-code>
        <location>/errors/400.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/errors/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/errors/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/errors/500.jsp</location>
    </error-page>
</web-app>
